# Copy this file to .env and fill in at least ONE key. Never commit .env.
# Free key (no card): https://console.groq.com/keys
GROQ_API_KEY=
# Free key (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# LLM_PROVIDER=groq          # groq | gemini
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# TOP_K=5
# MAX_DISTANCE=0.80          # lower = stricter relevance filter
# CHROMA_DIR=./chroma_db
